# ─── Base de datos (Supabase) ─────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# ─── Sesión ───────────────────────────────────────────────────────────────────
# Secreto para firmar los JWT de sesión. Generá uno con: openssl rand -hex 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# URL pública de la app (links en mails y back_urls de MercadoPago).
# Producción: https://pointix.com.ar
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── MercadoPago ──────────────────────────────────────────────────────────────
# Cifra en la DB el access token que pega cada club (AES-256-GCM).
# Base64 de 32 bytes: openssl rand -base64 32
# Obligatoria en producción: sin ella los tokens quedan en texto plano.
MP_ENCRYPTION_KEY=""

# ─── Emails (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Pointix <reservas@pointix.com.ar>"

# ─── Cron de verificación de pagos ────────────────────────────────────────────
# Lo manda cron-job.org en "Authorization: Bearer <CRON_SECRET>".
# Obligatoria: sin ella /api/cron/verify-payments no corre.
CRON_SECRET=""
